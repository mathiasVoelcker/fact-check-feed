# Postgres connection string (Neon in production, a local or test database in development)
DATABASE_URL=

# API key for the LLM provider used to classify rating text
GEMINI_API_KEY=

# Browser tests only (npm run test:e2e): a LOCAL Postgres, e.g. the Docker one in tests/test-guide.md. Any non-local host is refused.
# E2E_DATABASE_URL=postgres://e2e:e2e@127.0.0.1:5433/e2e
